{
  "compilerOptions": {
    "module": "ESNext",
    "rootDir": ".",
    "outDir": "./dist",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "target": "ES2023",
    "esModuleInterop": true,
    "ignoreDeprecations": "5.0"
  },
  "include": ["src", "api", "src/app/modules/task/task.interface.ts"],
  "exclude": ["node_modules", "dist", "generated/prisma"]
}
