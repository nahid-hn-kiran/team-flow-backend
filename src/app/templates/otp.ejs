<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Reset your password</title>

    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f4f7fb;
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica,
          Arial, sans-serif;
        color: #172033;
      }

      .wrapper {
        width: 100%;
        padding: 48px 16px;
        box-sizing: border-box;
      }

      .container {
        max-width: 560px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(15, 23, 42, 0.08);
      }

      .header {
        background-color: #111827;
        padding: 28px 32px;
        text-align: center;
      }

      .logo {
        color: #ffffff;
        font-size: 24px;
        font-weight: 700;
        letter-spacing: -0.5px;
      }

      .content {
        padding: 40px 36px;
      }

      .icon {
        width: 52px;
        height: 52px;
        margin: 0 auto 24px;
        background-color: #eef2ff;
        border-radius: 14px;
        text-align: center;
        line-height: 52px;
        font-size: 24px;
      }

      h1 {
        margin: 0 0 16px;
        text-align: center;
        font-size: 26px;
        line-height: 1.3;
        letter-spacing: -0.5px;
        color: #111827;
      }

      .greeting {
        font-size: 16px;
        line-height: 1.7;
        margin-bottom: 12px;
      }

      .description {
        font-size: 15px;
        line-height: 1.7;
        color: #667085;
        margin-bottom: 28px;
      }

      .otp-container {
        margin: 28px 0;
        padding: 24px;
        background-color: #f8fafc;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        text-align: center;
      }

      .otp-label {
        margin: 0 0 10px;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #667085;
      }

      .otp {
        margin: 0;
        font-size: 34px;
        font-weight: 700;
        letter-spacing: 8px;
        color: #111827;
      }

      .expiration {
        margin-top: 12px;
        font-size: 13px;
        color: #667085;
      }

      .security-note {
        margin-top: 28px;
        padding: 16px;
        background-color: #fffbeb;
        border: 1px solid #fde68a;
        border-radius: 10px;
        color: #92400e;
        font-size: 13px;
        line-height: 1.6;
      }

      .footer {
        padding: 24px 32px;
        border-top: 1px solid #eef0f3;
        text-align: center;
        background-color: #fafafa;
      }

      .footer p {
        margin: 4px 0;
        font-size: 12px;
        line-height: 1.6;
        color: #98a2b3;
      }

      @media only screen and (max-width: 600px) {
        .wrapper {
          padding: 24px 12px;
        }

        .content {
          padding: 32px 24px;
        }

        .header {
          padding: 24px;
        }

        h1 {
          font-size: 23px;
        }

        .otp {
          font-size: 28px;
          letter-spacing: 6px;
        }
      }
    </style>
  </head>

  <body>
    <div class="wrapper">
      <div class="container">
        <!-- Header -->
        <div class="header">
          <div class="logo">TeamFlow</div>
        </div>

        <!-- Main Content -->
        <div class="content">
          <!-- Icon -->
          <div class="icon">🔐</div>

          <h1>Reset your password</h1>

          <p class="greeting">Hello <strong><%= name %></strong>,</p>

          <p class="description">
            We received a request to reset the password associated with your
            TeamFlow account. Use the verification code below to continue.
          </p>

          <!-- OTP -->
          <div class="otp-container">
            <p class="otp-label">Your verification code</p>

            <p class="otp"><%= otp %></p>

            <p class="expiration">
              This code will expire in <strong>2 minutes</strong>.
            </p>
          </div>

          <!-- Security Message -->
          <div class="security-note">
            <strong>Didn't request this?</strong><br />

            You can safely ignore this email. Your password will remain
            unchanged and no action is required.
          </div>

          <p
            style="
              margin-top: 28px;
              margin-bottom: 0;
              font-size: 14px;
              line-height: 1.6;
              color: #667085;
            "
          >
            For your security, never share this verification code with anyone,
            including TeamFlow support.
          </p>
        </div>

        <!-- Footer -->
        <div class="footer">
          <p>© <%= new Date().getFullYear() %> TeamFlow</p>

          <p>This is an automated security email. Please do not reply.</p>
        </div>
      </div>
    </div>
  </body>
</html>
