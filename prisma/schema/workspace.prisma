model Workspace {
    id          String    @id @default(uuid(7))
    name        String
    description String?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
    isDeleted   Boolean   @default(false)
    deletedAt   DateTime?

    projects Project[]
    members  WorkspaceMember[]

    @@map("workspace")
}
